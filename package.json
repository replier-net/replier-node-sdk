{
  "name": "replier-sdk",
  "version": "1.0.0",
  "description": "Official Node.js / TypeScript SDK for the Replier.net WhatsApp API",
  "license": "MIT",
  "homepage": "https://www.replier.net",
  "keywords": ["whatsapp", "replier", "api", "sdk", "messaging"],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
