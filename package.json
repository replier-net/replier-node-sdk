{
  "name": "replier-sdk",
  "version": "1.0.0",
  "description": "Official Node.js / TypeScript SDK for the Replier.net WhatsApp API",
  "keywords": [
    "whatsapp",
    "replier",
    "api",
    "sdk",
    "messaging"
  ],
  "homepage": "https://www.replier.net",
  "bugs": {
    "url": "https://github.com/replier-net/replier-node-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/replier-net/replier-node-sdk.git"
  },
  "license": "MIT",
  "author": "Badwe Najjar",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "dist/cjs/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "module": "dist/esm/index.js"
}
